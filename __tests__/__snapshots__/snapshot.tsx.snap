          class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8"
        >
          <div
            class="col-span-3"
          >
            <div
              class="bg-card text-card-foreground flex flex-col gap-6 border shadow-sm py-0 rounded-sm"
              data-slot="card"
            >
              <div
                class="@container/card-header auto-rows-min grid-rows-[auto_auto] gap-2 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6 flex flex-col items-stretch border-b p-0! sm:flex-row"
                data-slot="card-header"
              >
                <div
                  class="flex flex-1 flex-col justify-center gap-1 px-6 pt-4 pb-3 sm:py-0!"
                >
                  <div
                    class="leading-none font-semibold"
                    data-slot="card-title"
                  >
                    Statistik Panen Ikan
                  </div>
                  <div
                    class="text-muted-foreground text-sm"
                    data-slot="card-description"
                  >
                    Menampilkan data total panen bulanan (Frekuensi dan Ekor)
                  </div>
                </div>
                <div
                  class="flex"
                >
                  <button
                    class="relative z-30 flex flex-1 flex-col justify-center gap-1 border-t px-6 py-4 text-left even:border-l data-[active=true]:bg-muted/50 sm:border-t-0 sm:border-l sm:px-8 sm:py-6"
                    data-active="true"
                  >
                    <span
                      class="text-xs text-muted-foreground"
                    >
                      Frekuensi Panen (Kali)
                    </span>
                    <span
                      class="text-lg leading-none font-bold sm:text-3xl"
                    >
                      0
                    </span>
                  </button>
                  <button
                    class="relative z-30 flex flex-1 flex-col justify-center gap-1 border-t px-6 py-4 text-left even:border-l data-[active=true]:bg-muted/50 sm:border-t-0 sm:border-l sm:px-8 sm:py-6"
                    data-active="false"
                  >
                    <span
                      class="text-xs text-muted-foreground"
                    >
                      Panen (Ekor)
                    </span>
                    <span
                      class="text-lg leading-none font-bold sm:text-3xl"
                    >
                      0
                    </span>
                  </button>
                </div>
              </div>
              <div
                class="px-2 sm:p-6"
                data-slot="card-content"
              >
                <div
                  class="[&_.recharts-cartesian-axis-tick_text]:fill-muted-foreground [&_.recharts-cartesian-grid_line[stroke='#ccc']]:stroke-border/50 [&_.recharts-curve.recharts-tooltip-cursor]:stroke-border [&_.recharts-polar-grid_[stroke='#ccc']]:stroke-border [&_.recharts-radial-bar-background-sector]:fill-muted [&_.recharts-rectangle.recharts-tooltip-cursor]:fill-muted [&_.recharts-reference-line_[stroke='#ccc']]:stroke-border flex justify-center text-xs [&_.recharts-dot[stroke='#fff']]:stroke-transparent [&_.recharts-layer]:outline-hidden [&_.recharts-sector]:outline-hidden [&_.recharts-sector[stroke='#fff']]:stroke-transparent [&_.recharts-surface]:outline-hidden aspect-auto h-62.5 w-full"
                  data-chart="chart-_r_1_"
                  data-slot="chart"
                >
                  <style>
                    
 [data-chart=chart-_r_1_] {
  --color-frekuensi: var(--chart-2);
  --color-ekor: var(--secondary);
}


.dark [data-chart=chart-_r_1_] {
  --color-frekuensi: var(--chart-2);
  --color-ekor: var(--secondary);
}

                  </style>
                  <div
                    class="recharts-responsive-container"
                    style="width: 100%; height: 100%; min-width: 0;"
                  />
                </div>
              </div>
            </div>
          </div>
          <div
            class="bg-white rounded-sm border border-slate-200 p-6 flex flex-col h-full shadow-sm"
          >
            <div
              class="flex items-center justify-between mb-6"
            >
              <div>
                <h3
                  class="text-lg font-semibold text-slate-900"
                >
                  -
                   
                  Panen Terakhir
                </h3>
                <p
                  class="text-xs text-slate-500 mt-1"
                >
                  Riwayat terbaru dari kolam
                </p>
              </div>
              <div
                class="bg-lime-100 text-lime-700 px-3 py-1 rounded-full text-xs font-semibold"
              >
                Terbaru
              </div>
            </div>
            <div
              class="flex flex-col gap-2 flex-1"
            >
              <p
                class="text-sm text-slate-500"
              >
                Belum ada data panen terbaru.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section
      class="py-12 px-4"
    >
      <div
        class="max-w-3xl mx-auto"
      >
        <div
          class="text-center"
        >
          <h2
            class="text-2xl md:text-3xl font-medium text-slate-900 mb-4"
          >
            Tertarik bergabung dengan Lele Farm?
          </h2>
          <p
            class="text-slate-600 mb-8"
          >
            Dapatkan informasi terkini tentang budidaya ikan lele dan penawaran khusus.
          </p>
          <button
            class="bg-primary cursor-pointer text-white px-8 py-2.5 rounded-md text-sm font-medium hover:bg-primary/90 transition-colors"
          >
            Hubungi kami
          </button>
        </div>
      </div>
    </section>
    <footer
      class="py-6 px-4 bg-primary"
    >
      <div
        class="max-w-7xl mx-auto text-center flex justify-between items-center"
      >
        <p
          class="text-sm text-white font-medium"
        >
          © 
          2026
           Lele Farm. All rights reserved.
        </p>
        <p
          class="text-sm text-white mt-2"
        >
          Dibuat dengan 🎀 oleh Tim Lele Farm
        </p>
      </div>
    </footer>
  </main>
</div>
`;
